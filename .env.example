# Copia este archivo a backend/.env y reemplaza los valores de ejemplo.
DATABASE_URL=postgresql+psycopg://inventory_user:change_me@localhost:5432/inventory

# Genera una clave propia con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY= 
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes locales de Vite. En producción, reemplázalos por los dominios reales.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Solo SQLite en memoria es admitido por la suite de pruebas.
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
